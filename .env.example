# Copy to .env and fill in. Never commit the real .env file.

# --- Target model under test ---
# Point these at whatever OpenAI-compatible endpoint you're testing
# (e.g. OpenRouter, Together.ai, Groq, a local Ollama instance, etc.)
# Base URL only — no /chat/completions suffix. PyRIT's OpenAIChatTarget
# passes this straight to the OpenAI SDK, which appends /chat/completions
# itself; including it here causes a doubled path and a 404.
TARGET_ENDPOINT=https://openrouter.ai/api/v1
TARGET_API_KEY=
# Free-tier ":free" models share an account-wide cap of 50 requests/day
# unless you've added credits (OpenRouter then raises it to 1000/day).
# The run will detect this and stop early with a partial report rather
# than hang or crash — see run.trials_per_payload if you need to fit
# a run under the cap.
TARGET_MODEL=inclusionai/ling-3.0-flash:free

# --- Judge / scoring model ---
# Used only to score whether an attack succeeded — not the system under test.
# Fine to point this at a stronger/cheaper hosted model.
JUDGE_ENDPOINT=https://openrouter.ai/api/v1
JUDGE_API_KEY=
JUDGE_MODEL=openai/gpt-4o-mini
