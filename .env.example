# Copy to .env and fill in. Never commit the real .env file.

# --- Target model under test ---
# Point these at whatever OpenAI-compatible endpoint you're testing
# (e.g. OpenRouter, Together.ai, Groq, a local Ollama instance, etc.)
TARGET_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
TARGET_API_KEY=
TARGET_MODEL=mistralai/mistral-7b-instruct

# --- Judge / scoring model ---
# Used only to score whether an attack succeeded — not the system under test.
# Fine to point this at a stronger/cheaper hosted model.
JUDGE_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
JUDGE_API_KEY=
JUDGE_MODEL=openai/gpt-4o-mini
